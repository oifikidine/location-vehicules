<!-- Reservation — Route GET : /reservation/:id POST : /reservation -->
<%- include('header') %>
<h1>Reserver un vehicule</h1>
<div class="detail-vehicule">
 <% if (vehicule.image) { %>
 <img src="/images/<%= vehicule.image %>"
 alt="<%= vehicule.marque %> <%= vehicule.modele %>">
 <% } %>
 <h2><%= vehicule.marque %> <%= vehicule.modele %></h2>
 <p class="prix"><%= vehicule.prix_journalier %> euros / jour</p>
</div>
<form method="POST" action="/reservation">
 <!-- Champ cache : envoie l'id du vehicule sans l'afficher -->
 <input type="hidden" name="id_vehicule" value="<%= vehicule.id %>">
 <label for="date_debut">Date de debut :</label>
 <input type="date" id="date_debut" name="date_debut" required>
 <label for="date_fin">Date de fin :</label>
 <input type="date" id="date_fin" name="date_fin" required>
 <button type="submit">Confirmer la reservation</button>
</form>
<%- include('footer') %>