<!DOCTYPE html> 
<html lang="fr">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Nos Vehicules</title>
 <link rel="stylesheet" href="/css/style.css">
</head>
<body>
 <nav>
 <a href="/">Accueil</a>
 <a href="/vehicules">Vehicules</a>
 <a href="/inscription">Inscription</a>
 <a href="/connexion">Connexion</a>
 <a href="/mes-reservations">Mes reservations</a>
 </nav>
 <h1>Nos vehicules disponibles</h1>
 <div class="liste-vehicules">
 <!-- On boucle sur chaque vehicule -->
 <% vehicules.forEach(function(v) { %>
 <div class="carte-vehicule">
 <img src="/images/<%= v.image %>" alt="<%= v.marque %> <%= v.modele %>">
 <h2><%= v.marque %> <%= v.modele %></h2>
 <p class="prix"><%= v.prix_journalier %> euros / jour</p>
 <a href="/reservation/<%= v.id %>">Reserver</a>
 </div>
 <% }); %>
 </div>
</body>
</html>